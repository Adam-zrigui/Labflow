# Kubernetes Secret template for LabFlow.
# Copy this file to secret.yaml and fill in real values.
# NEVER commit secret.yaml to version control.
#
# Usage:
#   cp k8s/secret.yaml.example k8s/secret.yaml
#   # Edit secret.yaml with real values
#   kubectl apply -f k8s/secret.yaml
#
# For Minikube, you can also use:
#   kubectl create secret generic labflow-secrets \
#     --from-literal=DATABASE_URL="postgresql://..." \
#     --from-literal=SESSION_SECRET="..." \
#     ...
apiVersion: v1
kind: Secret
metadata:
  name: labflow-secrets
type: Opaque
stringData:
  DATABASE_URL: "postgresql://user:password@localhost:5432/labflow?sslmode=require"
  SESSION_SECRET: "replace-with-random-base64-string"
  NEXT_PUBLIC_FIREBASE_API_KEY: ""
  NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN: ""
  NEXT_PUBLIC_FIREBASE_PROJECT_ID: ""
  FIREBASE_ADMIN_PROJECT_ID: ""
  FIREBASE_ADMIN_CLIENT_EMAIL: ""
  FIREBASE_ADMIN_PRIVATE_KEY: ""
  STRIPE_SECRET_KEY: ""
  STRIPE_PUBLISHABLE_KEY: ""
  STRIPE_WEBHOOK_SECRET: ""
  STRIPE_PRICE_STARTER: ""
  STRIPE_PRICE_PRO: ""
  STRIPE_PRICE_ENTERPRISE: ""
  RESEND_API_KEY: ""
  RESEND_FROM_EMAIL: "LabFlow <notifications@labflow.app>"
  NEXT_PUBLIC_APP_URL: "http://localhost:3000"
