# Firebase Client SDK (public, exposed to browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Firebase Admin SDK (server-side only)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Session cookie secret (generate with: openssl rand -base64 32)
SESSION_SECRET=

# Database
DATABASE_URL=

# Redis (Upstash — use rediss:// protocol for TLS)
REDIS_URL=

# Upstash REST API (used for rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# App URL (used for Stripe checkout redirect + email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Price IDs — must be price_* IDs from your Stripe Dashboard, NOT prod_* product IDs
STRIPE_PRICE_STARTER=free
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
