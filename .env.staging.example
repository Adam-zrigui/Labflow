# LabFlow — Staging Environment
#
# IMPORTANT: Staging must use completely separate service instances from production.
# Never share database, Redis, Stripe, or Firebase resources between environments.
#
# Neon:       Create a separate project or branch for staging.
#             Use a different DATABASE_URL than production.
# Upstash:    Create a separate Redis instance for staging.
# Stripe:     Use test mode keys (sk_test_*), never live keys in staging.
# Firebase:   Use a separate Firebase project for staging auth.
# Sentry:     Use a separate Sentry project or at minimum separate DSN.

# Firebase Client SDK (public, exposed to browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Firebase Admin SDK (server-side only)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Session cookie secret (generate with: openssl rand -base64 32)
# Must be DIFFERENT from production — never share session keys across environments.
SESSION_SECRET=

# Database
# Use a separate Neon branch or project for staging.
DATABASE_URL=

# Redis (Upstash — use rediss:// protocol for TLS)
REDIS_URL=

# Upstash REST API (used for rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe — TEST MODE ONLY in staging (sk_test_*, pk_test_*)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Price IDs (test mode)
STRIPE_PRICE_STARTER=free
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
